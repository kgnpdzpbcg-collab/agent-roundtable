{
  "name": "agent-roundtable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test --import tsx tests/async-queue.test.ts tests/roundtable-router.test.ts",
    "dev:server": "tsx watch scripts/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "serve": "tsx scripts/server.ts",
    "smoke:codex": "tsx scripts/codex-smoke.ts",
    "smoke:claude": "tsx scripts/claude-code-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.273",
    "@assistant-ui/react": "0.15.20",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2"
  }
}
